# .env.example - Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO GITHUB!

# -------------------------------------------------------------
# Google Gemini AI Key (Used for Voice Assistant & AI matching)
# Get a free key from https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: client-side fallback if not using the Node.js Express server
VITE_GEMINI_API_KEY=

# -------------------------------------------------------------
# Backend API URL (for Android Capacitor builds)
# When running on Android device/emulator, point this to your server
# e.g., https://your-domain.run.app or http://10.0.2.2:3000
# For web browser testing, leave blank (auto-detected from origin)
# -------------------------------------------------------------
VITE_API_URL=

# -------------------------------------------------------------
# Port configuration
# -------------------------------------------------------------
PORT=3000
